<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="views.controllers.ActualizarPasswordController"
           style="-fx-background-color: rgba(0, 0, 0, 0.7);"
           stylesheets="@/css/pass.css">

    <!-- =========================================================
         PANEL CENTRAL
         ========================================================= -->
    <VBox alignment="CENTER"
          spacing="20"
          maxWidth="400"
          maxHeight="350"
          style="
              -fx-background-color: rgba(255, 255, 255, 0.95);
              -fx-background-radius: 15;
              -fx-padding: 25;
              -fx-border-color: linear-gradient(to right, #3a86ff, #8338ec);
              -fx-border-width: 1;
              -fx-border-radius: 15;
              -fx-effect: dropshadow(
                  gaussian,
                  rgba(0,0,0,0.3),
                  20,
                  0,
                  0,
                  5
              );
          ">

        <!-- =====================================================
             ENCABEZADO
             ===================================================== -->
        <HBox alignment="CENTER" spacing="10">

            <!-- Icono -->
            <ImageView fx:id="imgLogo"
                       fitWidth="24"
                       fitHeight="24"
                       preserveRatio="true"/>

            <!-- Título dinámico -->
            <Label fx:id="lblTitulo"
                   text="Configurar PIN"
                   style="
                       -fx-font-size: 20px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #3a86ff;
                   "/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Cerrar -->
            <Button fx:id="btnCerrar"
                    text="✕"
                    styleClass="btn-cerrar"/>

        </HBox>


        <!-- =====================================================
             SEPARADOR
             ===================================================== -->
        <Separator style="
            -fx-background-color:
            linear-gradient(to right, #3a86ff, #8338ec);
        "/>


        <!-- =====================================================
             CAMPO PIN
             ===================================================== -->
        <VBox spacing="15"
              alignment="CENTER_LEFT">

            <!-- Texto dinámico -->
            <Label fx:id="lblTextoCampo"
                   text="Ingresa tu nuevo PIN:"
                   style="
                       -fx-font-size: 14px;
                       -fx-text-fill: #555;
                   "/>


            <!-- =================================================
                 CONTENEDOR DEL CAMPO
                 ================================================= -->
            <VBox spacing="5"
                  style="
                      -fx-border-color: #dee2e6;
                      -fx-border-width: 0 0 1 0;
                      -fx-padding: 0 0 5 0;
                  ">

                <HBox alignment="CENTER_LEFT"
                      spacing="10">

                    <!-- PIN oculto -->
                    <PasswordField fx:id="txtPassword"
                                   promptText="Nuevo PIN"
                                   styleClass="campo-password-simple"
                                   maxWidth="Infinity"
                                   HBox.hgrow="ALWAYS"/>


                    <!-- PIN visible -->
                    <TextField fx:id="txtPasswordVisible"
                               promptText="Nuevo PIN"
                               styleClass="campo-password-simple"
                               visible="false"
                               managed="false"
                               maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"/>


                    <Region HBox.hgrow="ALWAYS"/>


                    <!-- Mostrar / ocultar PIN -->
                    <Button fx:id="btnTogglePassword"
                            styleClass="btn-ver-password-simple">

                        <graphic>

                            <ImageView fx:id="imgPasswordIcon"
                                       fitWidth="20"
                                       fitHeight="20"
                                       preserveRatio="true"/>

                        </graphic>

                    </Button>

                </HBox>

            </VBox>


            <!-- Mensaje -->
            <Label fx:id="lblMensaje"
                   text="El PIN debe tener al menos 2 caracteres"
                   style="
                       -fx-font-size: 12px;
                       -fx-text-fill: #888;
                   "/>

        </VBox>


        <!-- =====================================================
             SEPARADOR
             ===================================================== -->
        <Separator style="
            -fx-background-color:
            linear-gradient(to right, #3a86ff, #8338ec);
        "/>


        <!-- =====================================================
             BOTÓN PRINCIPAL
             ===================================================== -->
        <StackPane>

            <Button fx:id="btnActualizar"
                    text="Crear PIN"
                    styleClass="btn-actualizar"/>


            <!-- Indicador de carga -->
            <ProgressIndicator fx:id="progressIndicator"
                               visible="false"
                               progress="0"
                               prefWidth="30"
                               prefHeight="30"/>

        </StackPane>

    </VBox>

</StackPane>
