<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.shape.*?>

<AnchorPane fx:id="root"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="views.controllers.HomeController"
    stylesheets="@/css/home.css"
    prefWidth="1200"
    prefHeight="600"
    style="-fx-background-color: #f1f5f9;">

    <!-- ===================================================== -->
    <!-- CABECERA                                              -->
    <!-- ===================================================== -->
    <HBox fx:id="header"
        spacing="15"
        AnchorPane.topAnchor="0"
        AnchorPane.leftAnchor="0"
        AnchorPane.rightAnchor="0"
        style="-fx-background-color: linear-gradient(to right, #1a3a6b, #2563eb);
                 -fx-padding: 12 25;
                 -fx-alignment: CENTER_LEFT;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 5);">

        <ImageView fx:id="imgLogo" fitWidth="32" fitHeight="32" preserveRatio="true"
            style="-fx-effect: dropshadow(gaussian, rgba(255,255,255,0.4), 6, 0, 0, 2);
                          -fx-border-color: rgba(255,255,255,0.3);
                          -fx-border-width: 1.5;
                          -fx-border-radius: 8;
                          -fx-background-radius: 8;
                          -fx-padding: 3;" />

        <VBox spacing="0">
            <Text fx:id="lblTitulo" text="UTILMARKET" fill="white"
                style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-font-family: 'Inter', 'Segoe UI', sans-serif;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 4, 0, 0, 2);" />
            <Text text="SISTEMA DE CAJA" fill="#bfdbfe"
                style="-fx-font-size: 11px; -fx-font-weight: 500; -fx-font-family: 'Inter', 'Segoe UI', sans-serif;" />
        </VBox>

        <ImageView fx:id="imgFotoEmpleado"
            fitWidth="44" fitHeight="44" preserveRatio="true"
            style="-fx-background-radius: 50%; -fx-background-color: #ffffff20; -fx-padding: 3;
                          -fx-border-color: rgba(255,255,255,0.25);
                          -fx-border-width: 1.5;
                          -fx-border-radius: 50%;" />

        <VBox spacing="1">
            <Text fx:id="lblEmpleado" text="Empleado" fill="white"
                style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-font-family: 'Inter', 'Segoe UI', sans-serif;" />
            <Text fx:id="lblSucursal" text="Sucursal" fill="#bfdbfe"
                style="-fx-font-size: 13px; -fx-font-weight: 400; -fx-font-family: 'Inter', 'Segoe UI', sans-serif;" />
        </VBox>

        <Pane HBox.hgrow="ALWAYS" />

        <HBox spacing="8">
            <Button fx:id="btnMinimizar" text="—" onAction="#minimizarVentana"
                styleClass="elegant-window-btn" />
            <Button fx:id="btnCerrar" text="✕" onAction="#cerrarVentana"
                styleClass="elegant-window-btn-close" />
            <Button fx:id="btnAbrirNavegador" onAction="#abrirNavegador"
                styleClass="elegant-window-btn" />
        </HBox>
    </HBox>

    <!-- ===================================================== -->
    <!-- MAIN: SIDEBAR IZQUIERDA + CONTENIDO DINÁMICO DERECHO  -->
    <!-- ===================================================== -->
    <HBox AnchorPane.topAnchor="70" AnchorPane.leftAnchor="0"
        AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="30"
        spacing="0">

        <!-- ============ SIDEBAR DE MENÚS ============ -->
        <VBox fx:id="sidebar" prefWidth="295" minWidth="295" maxWidth="295"
            spacing="10" styleClass="elegant-sidebar">

            <Label text="MENÚ PRINCIPAL" styleClass="sidebar-heading" />

            <!-- ITEM: INICIO -->
            <Button fx:id="btnInicio" onAction="#mostrarHome"
                styleClass="sidebar-item" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <StackPane minWidth="42" minHeight="42" maxWidth="42" maxHeight="42">
                            <Circle radius="21" fill="#eff6ff" stroke="#bfdbfe" strokeWidth="1.2" />
                            <ImageView fx:id="imgInicio" fitWidth="18" fitHeight="18"
                                preserveRatio="true" />
                        </StackPane>
                        <VBox spacing="2" alignment="CENTER_LEFT">
                            <Label text="Inicio" styleClass="sidebar-item-title" />
                            <Label text="Apertura de caja" styleClass="sidebar-item-sub" />
                        </VBox>
                    </HBox>
                </graphic>
            </Button>

            <!-- ITEM: ACTUALIZAR PIN -->
            <Button fx:id="btnActualizarContraseña" onAction="#actualizarContraseña"
                styleClass="sidebar-item" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <StackPane minWidth="42" minHeight="42" maxWidth="42" maxHeight="42">
                            <Circle radius="21" fill="#eff6ff" stroke="#bfdbfe" strokeWidth="1.2" />
                            <ImageView fx:id="imgUpdate" fitWidth="18" fitHeight="18"
                                preserveRatio="true" />
                        </StackPane>
                        <VBox spacing="2" alignment="CENTER_LEFT">
                            <Label text="Actualizar PIN" styleClass="sidebar-item-title" />
                            <Label text="Cambiar PIN de caja" styleClass="sidebar-item-sub" />
                        </VBox>
                    </HBox>
                </graphic>
            </Button>

            <!-- ITEM: PAPEL BOND — OCULTO POR DEFECTO -->
            <Button fx:id="btnPapelBond" onAction="#abrirControlPapelBond"
                styleClass="sidebar-item" maxWidth="Infinity" alignment="CENTER_LEFT"
                visible="false" managed="false">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <StackPane minWidth="42" minHeight="42" maxWidth="42" maxHeight="42">
                            <Circle radius="21" fill="#fef3c7" stroke="#fde68a" strokeWidth="1.2" />
                            <ImageView fx:id="imgPapelBond" fitWidth="18" fitHeight="18"
                                preserveRatio="true" />
                        </StackPane>
                        <VBox spacing="2" alignment="CENTER_LEFT">
                            <Label text="Papel Bond" styleClass="sidebar-item-title" />
                            <Label text="Control de papel" styleClass="sidebar-item-sub" />
                        </VBox>
                    </HBox>
                </graphic>
            </Button>

            <!-- ITEM: CONFIGURACIONES -->
            <Button fx:id="btnConfig" onAction="#abrirConfiguracion"
                styleClass="sidebar-item" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <StackPane minWidth="42" minHeight="42" maxWidth="42" maxHeight="42">
                            <Circle radius="21" fill="#eff6ff" stroke="#bfdbfe" strokeWidth="1.2" />
                            <ImageView fx:id="imgConfig" fitWidth="18" fitHeight="18"
                                preserveRatio="true" />
                        </StackPane>
                        <VBox spacing="2" alignment="CENTER_LEFT">
                            <Label text="Configuraciones" styleClass="sidebar-item-title" />
                            <Label text="Ajustes generales" styleClass="sidebar-item-sub" />
                        </VBox>
                    </HBox>
                </graphic>
            </Button>

            <!-- ITEM: SUCURSALES -->
            <Button fx:id="btnSucursales" onAction="#abrirSucursales"
                styleClass="sidebar-item" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <StackPane minWidth="42" minHeight="42" maxWidth="42" maxHeight="42">
                            <Circle radius="21" fill="#eff6ff" stroke="#bfdbfe" strokeWidth="1.2" />
                            <ImageView fx:id="imgSucursales" fitWidth="18" fitHeight="18"
                                preserveRatio="true" />
                        </StackPane>
                        <VBox spacing="2" alignment="CENTER_LEFT">
                            <Label text="Sucursales" styleClass="sidebar-item-title" />
                            <Label text="Gestión de sucursales" styleClass="sidebar-item-sub" />
                        </VBox>
                    </HBox>
                </graphic>
            </Button>

            <Pane VBox.vgrow="ALWAYS" />

            <!-- SEPARADOR (CORREGIDO) -->
            <Region styleClass="sidebar-separator">
                <VBox.margin>
                    <Insets top="4" right="4" bottom="6" left="4" />
                </VBox.margin>
            </Region>

            <!-- BOTÓN CERRAR SESIÓN (ámbar) -->
            <Button fx:id="btnCerrarSesion" onAction="#cerrarSesion"
                maxWidth="Infinity" alignment="CENTER_LEFT"
                styleClass="sidebar-item-logout">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <StackPane minWidth="34" minHeight="34" maxWidth="34" maxHeight="34">
                            <Circle radius="17" fill="white" stroke="#fcd34d" strokeWidth="1.2" />
                            <Label text="⎋"
                                style="-fx-font-size: 15px; -fx-font-weight: 900; -fx-text-fill: #b45309;" />
                        </StackPane>
                        <VBox spacing="1" alignment="CENTER_LEFT">
                            <Label text="Cerrar Sesión" styleClass="logout-title" />
                            <Label text="Volver al login" styleClass="logout-sub" />
                        </VBox>
                    </HBox>
                </graphic>
            </Button>

            <!-- BOTÓN SALIR (rojo) -->
            <Button fx:id="btnSalirSidebar" onAction="#salir"
                maxWidth="Infinity" alignment="CENTER_LEFT"
                styleClass="sidebar-item-salir">
                <graphic>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <StackPane minWidth="34" minHeight="34" maxWidth="34" maxHeight="34">
                            <Circle radius="17" fill="white" stroke="#fca5a5" strokeWidth="1.2" />
                            <Label text="⏻"
                                style="-fx-font-size: 15px; -fx-font-weight: 900; -fx-text-fill: #b91c1c;" />
                        </StackPane>
                        <VBox spacing="1" alignment="CENTER_LEFT">
                            <Label text="Salir" styleClass="exit-title" />
                            <Label text="Cerrar aplicación" styleClass="exit-sub" />
                        </VBox>
                    </HBox>
                </graphic>
            </Button>

            <!-- FOOTER -->
            <VBox styleClass="sidebar-footer" spacing="3">
                <HBox alignment="CENTER" spacing="6">
                    <Region prefWidth="14" prefHeight="2"
                        style="-fx-background-color: #2563eb; -fx-background-radius: 1;" />
                    <Label text="UTILMARKET" styleClass="sidebar-footer-brand" />
                    <Region prefWidth="14" prefHeight="2"
                        style="-fx-background-color: #2563eb; -fx-background-radius: 1;" />
                </HBox>
                <Label text="© 2025 · Todos los derechos reservados"
                    styleClass="sidebar-footer-version" />
            </VBox>
        </VBox>

        <!-- ============ CONTENIDO DERECHO (DINÁMICO) ============ -->
        <StackPane fx:id="contentArea" HBox.hgrow="ALWAYS">

            <!-- ▼ CONTENIDO POR DEFECTO (HOME) ▼ -->
            <VBox fx:id="homeContent" spacing="18" alignment="CENTER"
                style="-fx-padding: 18 40;">

                <VBox spacing="6" alignment="CENTER">
                    <Text text="APERTURA DE CAJA"
                        style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-fill: #1e293b; -fx-font-family: 'Inter', 'Segoe UI', sans-serif;" />
                    <HBox spacing="10" alignment="CENTER">
                        <Rectangle width="40" height="2" fill="#2563eb" arcWidth="2" arcHeight="2" />
                        <Rectangle width="12" height="2" fill="#94a3b8" />
                        <Rectangle width="40" height="2" fill="#2563eb" arcWidth="2" arcHeight="2" />
                    </HBox>
                </VBox>

                <Label
                    text="Seleccione la impresora que utilizará para trabajar con la caja registradora."
                    wrapText="true" alignment="CENTER"
                    style="-fx-font-size: 13px; -fx-text-fill: #475569; -fx-padding: 0 80 0 80; -fx-font-family: 'Inter', 'Segoe UI', sans-serif;" />

                <!-- TARJETA IMPRESORA -->
                <VBox alignment="CENTER" spacing="18"
                    style="-fx-background-color: #ffffff; -fx-padding: 25; -fx-background-radius: 20;
                             -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 20, 0, 0, 8);"
                    prefWidth="520" maxWidth="520">

                    <StackPane>
                        <Circle radius="42" fill="#eff6ff" stroke="#bfdbfe" strokeWidth="1.5" />
                        <ImageView fx:id="imgPrint" fitWidth="32" fitHeight="32"
                            preserveRatio="true" />
                    </StackPane>

                    <VBox spacing="6" alignment="CENTER_LEFT" prefWidth="440">
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Rectangle width="14" height="2" fill="#2563eb" />
                            <Label text="SELECCIONAR IMPRESORA"
                                style="-fx-font-size: 11px; -fx-text-fill: #475569; -fx-font-weight: 700; -fx-font-family: 'Inter', 'Segoe UI', sans-serif;" />
                        </HBox>
                        <ComboBox fx:id="cmbImpresoras" prefWidth="440" prefHeight="42"
                            promptText="Seleccione una impresora disponible"
                            styleClass="elegant-combo" />
                    </VBox>

                    <HBox spacing="15" alignment="CENTER">
                        <Button fx:id="btnRefrescar" text="ACTUALIZAR"
                            onAction="#refrescarImpresoras"
                            prefWidth="140" prefHeight="38" styleClass="elegant-btn-secondary" />
                        <Button fx:id="btnSeleccionar" text="CONFIRMAR"
                            onAction="#seleccionarImpresora"
                            prefWidth="140" prefHeight="38" styleClass="elegant-btn-primary" />
                    </HBox>
                </VBox>
            </VBox>
            <!-- ▲ FIN CONTENIDO HOME ▲ -->

        </StackPane>
    </HBox>

    <!-- ===================================================== -->
    <!-- PANTALLA DE CARGA (OVERLAY)                           -->
    <!-- ===================================================== -->
    <StackPane fx:id="loadingCard" visible="false"
        AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
        AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
        style="-fx-background-color: rgba(255, 255, 255, 0.92);">
        <VBox alignment="CENTER" spacing="20"
            style="-fx-background-color: #ffffff; -fx-padding: 40; -fx-background-radius: 18;
                     -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 18;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 25, 0, 0, 8);">
            <StackPane>
                <Circle radius="32" stroke="#e2e8f0" strokeWidth="2" fill="transparent" />
                <Circle radius="32" stroke="#2563eb" strokeWidth="3" fill="transparent"
                    style="-fx-stroke-dash-array: 201; -fx-stroke-dash-offset: 50;" />
            </StackPane>
            <VBox spacing="8" alignment="CENTER">
                <Label text="BUSCANDO IMPRESORAS"
                    style="-fx-font-size: 15px; -fx-font-weight: 800; -fx-text-fill: #1e293b; -fx-font-family: 'Inter', 'Segoe UI', sans-serif;" />
                <Label text="Espere mientras se cargan los dispositivos disponibles..."
                    style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-family: 'Inter', 'Segoe UI', sans-serif;" />
            </VBox>
        </VBox>
    </StackPane>

    <!-- VERSIÓN AL PIE -->
    <Text text="Version v12.0.0"
        AnchorPane.bottomAnchor="6"
        AnchorPane.leftAnchor="0"
        AnchorPane.rightAnchor="0"
        textAlignment="CENTER"
        style="-fx-font-size: 11px;
                 -fx-font-family: 'Inter', 'Segoe UI', sans-serif;
                 -fx-font-weight: 600;
                 -fx-fill: #94a3b8;" />

</AnchorPane>