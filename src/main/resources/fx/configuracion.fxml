<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<AnchorPane fx:id="root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="views.controllers.ConfiguracionController"
            stylesheets="@/css/configuracion.css"
            style="-fx-background-color: #f1f5f9;">

    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          style="-fx-background-color: #f1f5f9;">

        <!-- =============================== -->
        <!-- CABECERA (BLANCA)               -->
        <!-- =============================== -->
        <HBox fx:id="header" spacing="14" alignment="CENTER_LEFT"
              styleClass="header-blanco">

            <Button fx:id="btnVolver" text="←  Volver" onAction="#cerrar"
                    styleClass="btn-header-volver"/>

            <StackPane styleClass="icon-header-circle">
                <ImageView fx:id="imgSettingHeader" fitWidth="20" fitHeight="20"
                           preserveRatio="true"/>
            </StackPane>

            <VBox spacing="2" alignment="CENTER_LEFT">
                <Label text="CONFIGURACIÓN"
                       styleClass="titulo-header"/>
                <Label text="Ajustes de modos inteligentes"
                       styleClass="subtitulo-header"/>
            </VBox>
        </HBox>

        <!-- =============================== -->
        <!-- CONTENIDO                       -->
        <!-- =============================== -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="16" style="-fx-padding: 30 40;">

                <Label text="MODOS DE OPERACIÓN" styleClass="seccion-label"/>

                <!-- SWITCH 1: MODO INTELIGENTE -->
                <HBox spacing="16" alignment="CENTER_LEFT" styleClass="module-card">
                    <StackPane styleClass="module-icon, module-icon-blue">
                        <ImageView fx:id="imgModoInteligente" fitWidth="24" fitHeight="24"
                                   preserveRatio="true"/>
                    </StackPane>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Modo Inteligente"
                               styleClass="module-titulo"/>
                        <Label text="Detecta la venta en el navegador y abre la caja automáticamente."
                               wrapText="true"
                               styleClass="module-descripcion"/>
                    </VBox>
                    <ToggleButton fx:id="switchModoInteligente"
                                  text="OFF"
                                  onAction="#toggleModoInteligente"
                                  styleClass="switch-toggle"
                                  prefWidth="76" prefHeight="36"/>
                </HBox>

                <!-- SWITCH 2: IMPRESIÓN INTELIGENTE -->
               <!-- SWITCH 2: IMPRESIÓN INTELIGENTE (BETA / EXPERIMENTAL) -->
<HBox spacing="16" alignment="CENTER_LEFT" styleClass="module-card">
    <StackPane styleClass="module-icon, module-icon-slate">
        <ImageView fx:id="imgImpresionInteligente" fitWidth="24" fitHeight="24"
                   preserveRatio="true"/>
    </StackPane>
    <VBox spacing="4" HBox.hgrow="ALWAYS">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Impresión de Comprobante Inteligente"
                   styleClass="module-titulo"/>
            <Label text="BETA" styleClass="badge-beta"/>
        </HBox>
        <Label text="Imprime el comprobante automáticamente :aún no es 100% efectiva."
               wrapText="true"
               styleClass="module-descripcion"/>
    </VBox>
    <ToggleButton fx:id="switchImpresionInteligente"
                  text="OFF"
                  onAction="#toggleImpresionInteligente"
                  styleClass="switch-toggle"
                  prefWidth="76" prefHeight="36"/>
</HBox>
                

                <!-- =============================== -->
                <!-- MÓDULOS                         -->
                <!-- =============================== -->
                <Label text="MÓDULOS" styleClass="seccion-label, seccion-label-espaciada"/>

                <!-- SWITCH 3: PAPEL BOND -->
                <HBox spacing="16" alignment="CENTER_LEFT" styleClass="module-card">
                    <StackPane styleClass="module-icon, module-icon-amber">
                        <ImageView fx:id="imgModuloPapelBond" fitWidth="24" fitHeight="24"
                                   preserveRatio="true"/>
                    </StackPane>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Control de Papel Bond"
                               styleClass="module-titulo"/>
                        <Label text="Habilita el módulo de registro y control de consumo de papel bond."
                               wrapText="true"
                               styleClass="module-descripcion"/>
                    </VBox>
                    <ToggleButton fx:id="switchModuloPapelBond"
                                  text="OFF"
                                  onAction="#toggleModuloPapelBond"
                                  styleClass="switch-toggle"
                                  prefWidth="76" prefHeight="36"/>
                </HBox>

            </VBox>
        </ScrollPane>

        <!-- =============================== -->
        <!-- PIE                             -->
        <!-- =============================== -->
        <HBox alignment="CENTER_RIGHT" spacing="10"
              style="-fx-padding: 18 40;
                     -fx-background-color: #ffffff;
                     -fx-border-color: #e2e8f0 transparent transparent transparent;
                     -fx-border-width: 1 0 0 0;">
            <Button fx:id="btnCancelar" text="CANCELAR" onAction="#cerrar"
                    styleClass="elegant-btn-secondary"
                    prefWidth="140" prefHeight="42"/>
            <Button fx:id="btnGuardar" text="GUARDAR" onAction="#guardar"
                    styleClass="elegant-btn-primary"
                    prefWidth="140" prefHeight="42"/>
        </HBox>

    </VBox>
</AnchorPane>